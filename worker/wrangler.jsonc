{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hare-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  // The bucket must already exist for manual Wrangler deployment.
  "r2_buckets": [
    {
      "binding": "SYNC_BUCKET",
      "bucket_name": "hare-sync"
    }
  ]
}
